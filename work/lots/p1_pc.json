    {
      "file": "Scrutinized_Data/level3",
      "path_id": 10598,
      "field": "m_text",
      "context": "UI/ComputerUI/Desktop/EmailWindow/Content/Body/EmailBody",
      "en": "Hey,\r\n\r\nLights throughout my home are randomly turning off without me touching any of the switches. Also if I leave my security camera light on too long the breaker trips.\r\n\r\nI’d like a quote and your soonest possible opening to get this mess sorted.\r\n\r\nThank you,\r\n\r\nLuna\r\n",
      "fr": "Bonjour,\r\n\r\nLes lumières de la maison s'éteignent seules, sans que je touche aux interrupteurs. Et si je laisse la lumière de ma caméra allumée trop longtemps, le disjoncteur saute.\r\n\r\nJe voudrais un devis et votre premier créneau pour régler ça.\r\n\r\nMerci,\r\n\r\nLuna\r\n"
    },
